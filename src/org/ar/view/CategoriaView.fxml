<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="480.0" prefWidth="760.0" styleClass="root-categoria" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ar.controller.CategoriaViewController">
    <stylesheets>
        <URL value="@/org/ar/view/style/categoriaview.css" />
    </stylesheets>
    <children>

        <!-- Panel izquierdo: Registrar Categoria -->
        <VBox layoutX="20.0" layoutY="20.0" prefWidth="230.0" spacing="12.0">
            <children>
                <Label styleClass="titulo-seccion" text="Registrar Categoría" />
                <TextField fx:id="txtNombre" promptText="Nombre de la Categoría" />
                <HBox spacing="12.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarCategoria" text="Guardar" />
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarCampos" text="Limpiar" />
                    </children>
                </HBox>
                <Label fx:id="lblMensaje" wrapText="true" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>

        <!-- Panel derecho: Lista de Categorias -->
        <VBox layoutX="270.0" layoutY="20.0" prefWidth="470.0" spacing="10.0">
            <children>
                <Label styleClass="titulo-seccion" text="Lista de Categorías" />
                <TableView fx:id="tblCategorias" prefHeight="330.0" prefWidth="460.0">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="110.0" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="340.0" text="Nombre" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER" spacing="12.0">
                    <children>
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizarTabla" text="Actualizar Tabla" />
                        <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#volverMenu" text="Volver al Menú" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>

    </children>
</AnchorPane>

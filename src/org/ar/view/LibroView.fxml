<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ar.controller.LibroFXController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding><Insets right="20" /></padding>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Libro" />
            <TextField fx:id="txtIsbn" promptText="ISBN" />
            <TextField fx:id="txtTitulo" promptText="Título" />
            <TextField fx:id="txtFechaPublicacion" promptText="Fecha de Publicación (aaaa-mm-dd)" />
            <TextField fx:id="txtPrecio" promptText="Precio" />
            <TextField fx:id="txtIdCategoria" promptText="Id Categoría" />
            <TextField fx:id="txtNitEditorial" promptText="Nit Editorial" />
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" />
                <Button onAction="#handleLimpiar" prefWidth="120" text="Limpiar" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Libros" />
            <TableView fx:id="tablaLibros">
                <columns>
                    <TableColumn fx:id="colIsbn" prefWidth="110" text="ISBN">
                        <cellValueFactory>
                            <PropertyValueFactory property="isbn" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colTitulo" prefWidth="180" text="Título">
                        <cellValueFactory>
                            <PropertyValueFactory property="titulo" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colFechaPublicacion" prefWidth="120" text="Fecha Pub.">
                        <cellValueFactory>
                            <PropertyValueFactory property="fechaPublicacion" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colPrecio" prefWidth="90" text="Precio">
                        <cellValueFactory>
                            <PropertyValueFactory property="precio" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colIdCategoria" prefWidth="90" text="Id Cat.">
                        <cellValueFactory>
                            <PropertyValueFactory property="idCategoria" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colNitEditorial" prefWidth="110" text="Nit Editorial">
                        <cellValueFactory>
                            <PropertyValueFactory property="nitEditorial" />
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button onAction="#handleActualizar" text="Actualizar Tabla" />
                <Button onAction="#handleVolver" text="Volver al Menú" />
            </HBox>
        </VBox>
    </center>
</BorderPane>

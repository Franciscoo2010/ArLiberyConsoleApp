<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane id="BorderPane" prefHeight="620.0" prefWidth="980.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ar.controller.EditorialViewController">
    <stylesheets>
        <URL value="@/org/ar/view/style/editorialview.css" />
    </stylesheets>
    <left>
        <VBox prefWidth="300.0" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label text="Registrar Editorial">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
                <TextField fx:id="txtNit" promptText="NIT" />
                <TextField fx:id="txtNombre" promptText="Nombre de la Editorial" />
                <TextField fx:id="txtTelefono" promptText="Teléfono" />
                <TextField fx:id="txtDireccion" promptText="Dirección" />
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#eventoGuardar" text="Guardar" />
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#eventoLimpiar" text="Limpiar" />
                    </children>
                </HBox>
                <Label fx:id="lblMensaje" text="" textFill="#f83737" wrapText="true" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label text="Lista de Editoriales">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
                <TableView fx:id="tablaEditoriales" prefHeight="460.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNit" prefWidth="120.0" text="NIT" />
                        <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
                        <TableColumn fx:id="colTelefono" prefWidth="140.0" text="Teléfono" />
                        <TableColumn fx:id="colDireccion" prefWidth="220.0" text="Dirección" />
                    </columns>
                </TableView>
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnActualizarTabla" mnemonicParsing="false" onAction="#eventoActualizarTabla" text="Actualizar Tabla" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
